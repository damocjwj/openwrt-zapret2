{
  "api_version": 1,
  "schema_version": 2,
  "sections": [
    {
      "name": "main",
      "type": "zapret2",
      "options": {
        "schema_version": "2", "enabled": "0", "ipv4": "1", "ipv6": "1",
        "process_forwarded": "1", "process_local": "0", "intercept_mode": "marked",
        "all_traffic_ack": "0", "connection_mark": "0x20000000", "generated_mark": "0x40000000",
        "queue_num": "200", "tcp_out_packets": "20", "tcp_in_packets": "10",
        "udp_out_packets": "5", "udp_in_packets": "3", "other_out_packets": "5", "other_in_packets": "3"
      },
      "lists": { "wan_network": [ "wan" ], "source_network": [ "lan" ] }
    },
    {
      "name": "tls_fixture", "type": "profile",
      "options": { "id": "tls_fixture", "name": "TLS fixture", "enabled": "1", "order": "10", "family": "dual", "queue_mode": "initial" },
      "lists": { "tcp_port": [ "443" ], "l7": [ "tls" ] }
    },
    {
      "name": "tls_payload", "type": "step",
      "options": { "id": "tls_payload", "profile": "tls_fixture", "order": "10", "type": "payload" },
      "lists": { "value": [ "tls_client_hello" ] }
    },
    {
      "name": "tls_split", "type": "step",
      "options": { "id": "tls_split", "profile": "tls_fixture", "order": "20", "type": "multisplit", "position": "1" },
      "lists": {}
    }
  ]
}
