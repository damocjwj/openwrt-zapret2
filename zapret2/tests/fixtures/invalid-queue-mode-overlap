config zapret2 'main'
	option schema_version '2'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '1'
	option process_forwarded '1'
	option process_local '0'
	option intercept_mode 'marked'
	option all_traffic_ack '0'
	option connection_mark '0x20000000'
	option generated_mark '0x40000000'
	option queue_num '200'
	option tcp_out_packets '20'
	option tcp_in_packets '10'
	option udp_out_packets '5'
	option udp_in_packets '3'
	option other_out_packets '5'
	option other_in_packets '3'
	list wan_network 'wan'
	list source_network 'lan'

config profile 'tls_initial'
	option id 'tls_initial'
	option name 'TLS initial fixture'
	option enabled '1'
	option order '10'
	option family 'dual'
	option queue_mode 'initial'
	list tcp_port '400-500'
	list l7 'tls'

config step 'tls_initial_split'
	option id 'tls_initial_split'
	option profile 'tls_initial'
	option order '10'
	option type 'multisplit'
	option position '1'

config profile 'tls_keepalive'
	option id 'tls_keepalive'
	option name 'TLS keepalive fixture'
	option enabled '1'
	option order '20'
	option family 'dual'
	option queue_mode 'keepalive'
	list tcp_port '443'
	list l7 'tls'

config step 'tls_keepalive_split'
	option id 'tls_keepalive_split'
	option profile 'tls_keepalive'
	option order '10'
	option type 'multisplit'
	option position '1'
