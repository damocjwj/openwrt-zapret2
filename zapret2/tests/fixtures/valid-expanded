config zapret2 'main'
	option schema_version '2'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '1'
	list wan_network 'wan'
	list source_network 'lan'
	option process_forwarded '1'
	option process_local '1'
	option intercept_mode 'marked'
	option all_traffic_ack '1'
	option connection_mark '0x20000000'
	option generated_mark '0x40000000'
	option queue_num '200'
	option tcp_out_packets '20'
	option tcp_in_packets '10'
	option udp_out_packets '5'
	option udp_in_packets '3'
	option other_out_packets '5'
	option other_in_packets '3'

config profile 'tcp_actions'
	option id 'tcp_actions'
	option enabled '1'
	option order '10'
	option family 'dual'
	option queue_mode 'keepalive'
	list tcp_port '22'
	list l7 'tls'

config step 's_payload'
	option id 's_payload'
	option profile 'tcp_actions'
	option order '10'
	option type 'payload'
	list value 'tls_client_hello'

config step 's_range'
	option id 's_range'
	option profile 'tcp_actions'
	option order '20'
	option type 'out_range'
	option range 'b0-b4096'

config step 's_clone'
	option id 's_clone'
	option profile 'tcp_actions'
	option order '30'
	option type 'tls_client_hello_clone'
	option blob 'fixture_clone'

config step 's_fake'
	option id 's_fake'
	option profile 'tcp_actions'
	option order '40'
	option type 'fake'
	option blob 'fixture_clone'
	option repeats '2'

config step 's_multi'
	option id 's_multi'
	option profile 'tcp_actions'
	option order '50'
	option type 'multisplit'
	option position '1,midsld'

config step 's_disorder'
	option id 's_disorder'
	option profile 'tcp_actions'
	option order '60'
	option type 'multidisorder'
	option position '1,midsld'

config step 's_legacy'
	option id 's_legacy'
	option profile 'tcp_actions'
	option order '70'
	option type 'multidisorder_legacy'
	option position '1'

config step 's_fsplit'
	option id 's_fsplit'
	option profile 'tcp_actions'
	option order '80'
	option type 'fakedsplit'
	option position '1'
	option pattern 'fake_default_tls'

config step 's_fdisorder'
	option id 's_fdisorder'
	option profile 'tcp_actions'
	option order '90'
	option type 'fakeddisorder'
	option position '1'
	option pattern 'fake_default_tls'

config step 's_hostfake'
	option id 's_hostfake'
	option profile 'tcp_actions'
	option order '100'
	option type 'hostfakesplit'
	option host 'example.com'
	option position 'midsld'

config step 's_tcpseg'
	option id 's_tcpseg'
	option profile 'tcp_actions'
	option order '110'
	option type 'tcpseg'
	option position '1,2'

config step 's_oob'
	option id 's_oob'
	option profile 'tcp_actions'
	option order '120'
	option type 'oob'
	option byte '0'
	option urp 'b'

config step 's_http_hostcase'
	option id 's_http_hostcase'
	option profile 'tcp_actions'
	option order '130'
	option type 'http_hostcase'
	option spell 'hOsT'

config step 's_http_domcase'
	option id 's_http_domcase'
	option profile 'tcp_actions'
	option order '140'
	option type 'http_domcase'

config step 's_http_methodeol'
	option id 's_http_methodeol'
	option profile 'tcp_actions'
	option order '150'
	option type 'http_methodeol'

config step 's_http_unixeol'
	option id 's_http_unixeol'
	option profile 'tcp_actions'
	option order '160'
	option type 'http_unixeol'

config step 's_wsize'
	option id 's_wsize'
	option profile 'tcp_actions'
	option order '170'
	option type 'wsize'
	option size '1'

config step 's_wssize'
	option id 's_wssize'
	option profile 'tcp_actions'
	option order '180'
	option type 'wssize'
	option size '1'
	option scale '6'

config step 's_syndata'
	option id 's_syndata'
	option profile 'tcp_actions'
	option order '190'
	option type 'syndata'

config step 's_synack'
	option id 's_synack'
	option profile 'tcp_actions'
	option order '200'
	option type 'synack'

config step 's_synack_split'
	option id 's_synack_split'
	option profile 'tcp_actions'
	option order '210'
	option type 'synack_split'
	option mode 'syn'

config step 's_send'
	option id 's_send'
	option profile 'tcp_actions'
	option order '220'
	option type 'send'
	option direction 'out'

config step 's_pktmod'
	option id 's_pktmod'
	option profile 'tcp_actions'
	option order '230'
	option type 'pktmod'
	option direction 'out'
	option ip_ttl '2'

config step 's_rst'
	option id 's_rst'
	option profile 'tcp_actions'
	option order '240'
	option type 'rst'
	option direction 'out'
	option rstack '1'

config profile 'udp_actions'
	option id 'udp_actions'
	option enabled '1'
	option order '20'
	option family 'dual'
	option queue_mode 'initial'
	list udp_port '*'
	list l7 'quic'

config step 'u_payload'
	option id 'u_payload'
	option profile 'udp_actions'
	option order '10'
	option type 'payload'
	list value 'quic_initial'

config step 'u_fake'
	option id 'u_fake'
	option profile 'udp_actions'
	option order '20'
	option type 'fake'
	option blob 'fake_default_quic'

config step 'u_len'
	option id 'u_len'
	option profile 'udp_actions'
	option order '30'
	option type 'udplen'
	option increment '8'

config step 'u_dht'
	option id 'u_dht'
	option profile 'udp_actions'
	option order '40'
	option type 'dht_dn'
	option dn '1'

config profile 'icmp_filter'
	option id 'icmp_filter'
	option enabled '1'
	option order '30'
	option family 'dual'
	option queue_mode 'initial'
	list icmp '8:0'

config step 'i_payload'
	option id 'i_payload'
	option profile 'icmp_filter'
	option order '5'
	option type 'payload'
	list value 'icmp'

config step 'i_drop'
	option id 'i_drop'
	option profile 'icmp_filter'
	option order '10'
	option type 'drop'
	option direction 'out'

config profile 'ipp_filter'
	option id 'ipp_filter'
	option enabled '1'
	option order '40'
	option family 'dual'
	option queue_mode 'initial'
	list ip_protocol '47'

config step 'i_send'
	option id 'i_send'
	option profile 'ipp_filter'
	option order '10'
	option type 'send'
	option direction 'out'

config profile 'contract_auto'
	option id 'contract_auto'
	option enabled '1'
	option order '50'
	option family 'dual'
	option queue_mode 'initial'
	list tcp_port '443'
	list l7 'tls'
	option autohostlist '1'
	option auto_fail_threshold '3'
	option auto_fail_time '60'
	option auto_retrans_threshold '3'
	option auto_retrans_maxseq '32768'
	option auto_retrans_reset '1'
	option auto_incoming_maxseq '4096'
	option auto_udp_out '4'
	option auto_udp_in '1'

config step 'a_split'
	option id 'a_split'
	option profile 'contract_auto'
	option order '10'
	option type 'multisplit'
	option position '1'
