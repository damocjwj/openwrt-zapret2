config zapret2 'main'
	option schema_version '2'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '1'
	list wan_network 'wan'
	list source_network 'lan'
	option process_forwarded '1'
	option process_local '0'
	option intercept_mode 'marked'
	option all_traffic_ack '0'
	option connection_mark '0x20000000'
	option generated_mark '0x40000000'
	option queue_num '200'
	option tcp_out_packets '20'
	option tcp_in_packets '10'
	option udp_out_packets '5'
	option udp_in_packets '3'
	option other_out_packets '5'
	option other_in_packets '3'
	option debug_mode 'off'
	option bind_fix4 '0'
	option bind_fix6 '0'
	option ipcache_hostname '0'
	option ipcache_lifetime '7200'
	option ctrack_disable '0'
	option ctrack_syn_timeout '60'
	option ctrack_established_timeout '300'
	option ctrack_fin_timeout '60'
	option ctrack_udp_timeout '60'
	option lua_gc_interval '300'

config profile 'tls_fixture'
	option id 'tls_fixture'
	option name 'TLS fixture'
	option enabled '1'
	option order '10'
	option family 'dual'
	option queue_mode 'initial'
	list tcp_port '443'
	list l7 'tls'

config step 'tls_payload'
	option id 'tls_payload'
	option profile 'tls_fixture'
	option order '10'
	option type 'payload'
	list value 'tls_client_hello'

config step 'tls_split'
	option id 'tls_split'
	option profile 'tls_fixture'
	option order '30'
	option type 'multisplit'
	option position '1'

config step 'tls_byte_range'
	option id 'tls_byte_range'
	option profile 'tls_fixture'
	option order '20'
	option type 'out_range'
	option range 'b0-b4096'
